# ---- Supabase (Project Settings > API) ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # clave "service_role" (secreta, solo servidor)

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_TOKEN=EAAG...             # token permanente (usuario del sistema)
PHONE_ID=123456789012345           # Phone number ID
WHATSAPP_VERIFY_TOKEN=mi-arriendo-verifica   # texto que tú inventas, igual en Meta
WHATSAPP_TEMPLATE_NAME=recordatorio_arriendo
WHATSAPP_TEMPLATE_LANG=es
APP_SECRET=                        # (opcional) "App secret" de Meta para validar el webhook

# ---- Seguridad del panel ----
ADMIN_PASSWORD=cambia-esta-clave
AUTH_SECRET=texto-largo-aleatorio
CRON_SECRET=otro-texto-largo-aleatorio   # Vercel lo envía solo al ejecutar el cron
